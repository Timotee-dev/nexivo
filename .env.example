# ============================================================
# NEXIVO — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
# ============================================================

# ── Django ────────────────────────────────────────────────
SECRET_KEY=django-insecure-REPLACE-THIS-WITH-A-REAL-50-CHAR-RANDOM-STRING
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
FRONTEND_URL=http://localhost:8000
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8000
CSRF_TRUSTED_ORIGINS=http://localhost:8000

# ── Database ──────────────────────────────────────────────
# Leave blank to use SQLite in dev (auto-created at db.sqlite3)
# In production: postgres://USER:PASS@HOST:5432/DBNAME
DATABASE_URL=

# ── Redis / Celery ────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Field-level encryption ────────────────────────────────
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# ── Paystack ──────────────────────────────────────────────
PAYSTACK_SECRET_KEY=sk_test_XXXX
PAYSTACK_PUBLIC_KEY=pk_test_XXXX

# ── Flutterwave ───────────────────────────────────────────
FLUTTERWAVE_SECRET_KEY=FLWSECK_TEST-XXXX
FLUTTERWAVE_PUBLIC_KEY=FLWPUBK_TEST-XXXX
FLUTTERWAVE_ENCRYPTION_KEY=FLWENCRYPT-XXXX
# Optional: custom webhook hash for Flutterwave verification
FLUTTERWAVE_WEBHOOK_SECRET_HASH=

# ── Stripe ────────────────────────────────────────────────
STRIPE_SECRET_KEY=sk_test_XXXX
STRIPE_PUBLISHABLE_KEY=pk_test_XXXX
STRIPE_WEBHOOK_SECRET=whsec_XXXX

# ── Google OAuth ──────────────────────────────────────────
GOOGLE_OAUTH_CLIENT_ID=XXXX.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=

# ── Apple OAuth ───────────────────────────────────────────
APPLE_OAUTH_CLIENT_ID=com.nexivo.app

# ── Email (SMTP) ──────────────────────────────────────────
# Leave backend as console for local dev — emails print to terminal
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Nexivo <noreply@nexivo.com>

# ── WhatsApp ──────────────────────────────────────────────
WHATSAPP_API_URL=https://graph.facebook.com/v19.0/YOUR_PHONE_NUMBER_ID/messages
WHATSAPP_API_TOKEN=

# ── CAPTCHA ───────────────────────────────────────────────
# Provider: hcaptcha or recaptcha
CAPTCHA_PROVIDER=hcaptcha
CAPTCHA_SECRET_KEY=
CAPTCHA_SITE_KEY=

# ── NIN Verification ─────────────────────────────────────
# Provider: Youverify, VerifyMe, Smile Identity, Mono, etc.
NIN_VERIFICATION_PROVIDER_URL=
NIN_VERIFICATION_API_KEY=

# ── Cloud Storage (optional) ─────────────────────────────
USE_S3=False
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_STORAGE_BUCKET_NAME=
AWS_S3_REGION_NAME=eu-west-1
AWS_S3_CUSTOM_DOMAIN=
